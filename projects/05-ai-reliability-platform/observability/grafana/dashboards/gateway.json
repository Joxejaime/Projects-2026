{
  "uid": "ai-gateway-overview",
  "title": "AI Gateway - Reliability Overview",
  "tags": ["sre", "llm", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Availability (5m, SLO 99.5%)",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "1 - gateway:error_ratio:rate5m"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "red", "value": null}, {"color": "orange", "value": 0.99}, {"color": "green", "value": 0.995}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Fallback share (5m)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "gateway:degraded_ratio:rate5m"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.25}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Circuit: primary",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "gateway_circuit_state{provider=\"primary\"}"}],
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {
          "0": {"text": "CLOSED", "color": "green"},
          "1": {"text": "HALF-OPEN", "color": "orange"},
          "2": {"text": "OPEN", "color": "red"}}}]}}
    },
    {
      "id": 4, "type": "stat", "title": "p95 latency (5m)",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "gateway:latency_p95_seconds:rate5m"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(gateway_requests_total[1m]))", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Request latency percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_request_duration_seconds_bucket[1m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_seconds_bucket[1m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_request_duration_seconds_bucket[1m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Provider attempts by result",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider, result) (rate(gateway_provider_calls_total[1m]))", "legendFormat": "{{provider}} / {{result}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "gateway_circuit_state", "legendFormat": "{{provider}}"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 2, "custom": {"lineInterpolation": "stepAfter"}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Cache hit ratio",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(gateway_cache_events_total{event=\"hit\"}[1m])) / clamp_min(sum(rate(gateway_cache_events_total[1m])), 1e-9)", "legendFormat": "hit ratio"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Tokens per second (cost proxy)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (direction) (rate(gateway_tokens_total[1m]))", "legendFormat": "{{direction}}"}]
    }
  ]
}
