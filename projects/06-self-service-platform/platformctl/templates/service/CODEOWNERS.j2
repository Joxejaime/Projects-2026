# Changes to the service spec and deployment config need the code owner's review.
# Owning team (see service.yaml): [[ owner ]]. GitHub team handles (@org/team) only exist inside an
# organization; on a personal account the code owner is a user. Inside an org, scaffold with
# --code-owner @<org>/[[ owner ]].
*                [[ code_owner ]]
/service.yaml    [[ code_owner ]]
/k8s/            [[ code_owner ]]
